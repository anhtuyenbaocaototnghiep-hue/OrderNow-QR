# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit .env.
PORT=3000

# SQL Server (ứng dụng kết nối qua TCP bằng SQL login — xem docs/operations/local-development.md)
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_NAME=CafeQrDev
DB_USER=cafe_app
DB_PASSWORD=
DB_ENCRYPT=true
# true khi SQL Server dùng chứng chỉ tự ký (máy dev, Docker)
DB_TRUST_SERVER_CERT=true
# DB cho npm test / test:e2e / load — tên PHẢI kết thúc bằng "Test" (sẽ bị xóa sạch mỗi lần chạy test)
TEST_DB_NAME=CafeQrTest

# JWT cho nhân viên/quản lý — chuỗi ngẫu nhiên dài (ví dụ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Địa chỉ in trong QR bàn — đặt theo IP LAN của máy chủ để điện thoại khách truy cập được, ví dụ http://192.168.1.10:3000
PUBLIC_BASE_URL=http://localhost:3000

# Tên / địa chỉ quán MẶC ĐỊNH (in trên hóa đơn). Đổi ở Quản lý → Cài đặt (F-053); đã lưu ở đó thì hai dòng này không còn tác dụng
SHOP_NAME=Cà phê Mộc
SHOP_ADDRESS=

# Tài khoản quản lý đầu tiên (npm run db:seed) — đổi mật khẩu sau khi đăng nhập
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=

# Tùy chọn: RATE_LIMIT=off (chỉ dùng khi test), TRUST_PROXY=true khi chạy sau reverse proxy HTTPS

# Job nền (ADR-006): thống kê thời gian pha 02:00, dự báo nhập hàng, tổng hợp ngày 00:30, cảnh báo lô… Đặt false để tắt.
JOBS_ENABLED=true
# Thư mục lưu ảnh hóa đơn sổ quỹ (F-033). Mặc định: <repo>/uploads
# UPLOADS_DIR=
# Kênh Zalo OA cho chiến dịch (F-037). Để trống → chiến dịch chỉ dùng Xuất danh sách (CSV)
# ZALO_OA_TOKEN=
# ZALO_OA_URL=
# Email cảnh báo bất thường (F-060, ADR-020): hộp thư GỬI. Người NHẬN đặt ở Quản lý → Cài đặt → "Cảnh báo bất thường qua email".
# Gmail: bật xác minh 2 bước → tạo "Mật khẩu ứng dụng" (16 ký tự) → dán vào SMTP_PASS. KHÔNG dùng mật khẩu đăng nhập Gmail.
# Để trống → cảnh báo vẫn hiện trong app, email nằm chờ trong hàng đợi tới khi cấu hình (khởi động lại app sau khi sửa).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# Tên hiện ở ô "Từ" (mặc định = SMTP_USER), vd: Ca phe Moc <hop-thu-gui@gmail.com>
# MAIL_FROM=
# Tối đa số email / giờ (chống dội bom hộp thư)
# MAIL_HOURLY_MAX=20

# ---- Vận hành máy chạy thật (bước 15 — tài-liệu/vận-hành/backup-restore.md, monitoring.md) ----
# Thư mục lưu bản sao lưu (đường dẫn đầy đủ, nên ở ổ khác ổ hệ điều hành). SQL Server phải có quyền ghi — lệnh icacls trong backup-restore.md
# BACKUP_DIR=D:\cafe-qr-backup
# Bản chép thứ hai ngoài máy (thư mục đồng bộ đám mây của chủ quán / ổ USB). Để trống = chỉ lưu trong BACKUP_DIR
# BACKUP_COPY_DIR=
# Giữ bản hằng ngày bao nhiêu ngày / bản đầu tháng bao nhiêu tháng (mặc định 14 / 12)
# BACKUP_KEEP_DAYS=14
# BACKUP_KEEP_MONTHS=12
# Thư mục nhật ký kiểm tra hệ thống (mặc định <repo>/nhật-ký)
# LOG_DIR=
# npm run db:restore mặc định dùng đăng nhập Windows qua kết nối nội bộ "." — bản Express: RESTORE_SQL_SERVER=.\SQLEXPRESS
# RESTORE_SQL_SERVER=
# Khôi phục trên VPS / Docker (không có đăng nhập Windows): tài khoản quản trị SQL Server cho npm run db:restore
# RESTORE_SQL_USER=
# RESTORE_SQL_PASSWORD=
